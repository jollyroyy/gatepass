{
  "name": "gatepass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Quest Gate Pass — material gate pass control (RGP / NRGP, in / out) for the Quest Mall management office, with HOD and security gate consoles",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "check": "tsc -p tsconfig.app.json --noEmit && vitest run",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:security": "vitest run tests/security",
    "test:watch": "vitest",
    "create-user": "tsx scripts/create-user.ts",
    "build:sql": "node scripts/build-apply-all.mjs",
    "build:login-bg": "node scripts/make-login-bg.mjs",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "e2e:seed": "node scripts/e2e/seed.mjs",
    "e2e:restore": "node scripts/e2e/restore.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "date-fns": "^3.6.0",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "dotenv": "^16.6.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^3.0.0"
  }
}

# Copy this to .env and fill in your Supabase project values.
# Never commit .env — it is git-ignored.

VITE_SUPABASE_URL=your-project-url-here
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — used ONLY by node scripts in scripts/ (server-side, e.g. scripts/create-user.ts).
#
# NEVER prefix this with VITE_. Vite inlines every VITE_* variable directly into
# the client-side JS bundle at build time, so a VITE_ prefix here would ship the
# service-role key (which bypasses Row Level Security) to every visitor's browser.
# Keep it bare (SUPABASE_SERVICE_ROLE_KEY) so it is only readable by process.env
# in trusted node scripts, never by import.meta.env in the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# NOTE: migrations are applied through the authenticated Supabase MCP server, not
# with a direct connection string. Do not paste a real database URI into this
# file — .env.example is committed, unlike .env. If you ever do need psql, put
# SUPABASE_DB_URL in .env (git-ignored) and never here.
